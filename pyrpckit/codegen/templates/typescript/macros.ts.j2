{% macro operation(route, root) %}{% if route.summary %}  /** {{ route.summary | comment }} */
{% endif %}  {{ "async " if route.result | null_type else "" }}{{ route.operation_name | identifier }}({% if route.params %}params: {{ route.params_model }}{{ " = {}" if route.params | all_optional else "" }}{% endif %}): Promise<{{ "void" if route.result | null_type else route.result | type }}> {
{% if route.result | null_type %}    await {% else %}    return {% endif %}{{ "this.#rpc" if root else "this.rpc" }}.request<{{ route.result | type }}>({{ route | route_access }}{% if route.params %}, params{% endif %});
  }
{% endmacro %}

{% macro notification(event, root) %}{% if event.summary %}  /** {{ event.summary | comment }} */
{% endif %}  {{ event.operation_name | identifier }}(): AsyncIterable<{{ event.payload | type }}> {
{% if event | compact_notification(root) %}    return {{ "this.#rpc" if root else "this.rpc" }}.notifications<{{ event.payload | type }}>(notifications.{{ event | route_key }});
{% else %}    return {{ "this.#rpc" if root else "this.rpc" }}.notifications<{{ event.payload | type }}>(
      notifications.{{ event | route_key }},
    );
{% endif %}  }
{% endmacro %}

{% macro stream(item, root) %}{% if item.summary %}  /** {{ item.summary | comment }} */
{% endif %}{% set inline_signature = "  " ~ (item.operation_name | identifier) ~ "(options?: { readonly url?: string | URL }): Promise<" ~ (item | stream_connection) ~ "> {" %}{% if not item.variables and inline_signature | length <= 80 %}{{ inline_signature }}
{% else %}  {{ item.operation_name | identifier }}(options?: {
{% for variable in item.variables %}    readonly {{ variable.name | property }}?: {{ variable | server_variable_type }};
{% endfor %}    readonly url?: string | URL;
  }): Promise<{{ item | stream_connection }}> {
{% endif %}    return {{ "this.#rpc" if root else "this.rpc" }}.openStream(
      resolveStreamEndpoint(
        binaryStreams.{{ item.name | identifier }},
        {% if item.variables %}{
{% for variable in item.variables %}          {{ variable.name | property }}: options?.{{ variable.name | property }},
{% endfor %}        }{% else %}{}{% endif %},
        {{ "{ url: options?.url, defaults: this.#rpc.variables }" if root else "{ url: options?.url, defaults: this.rpc.variables }" }},
      ),
      (transport) => new {{ item | stream_connection }}(transport),
    );
  }
{% endmacro %}
