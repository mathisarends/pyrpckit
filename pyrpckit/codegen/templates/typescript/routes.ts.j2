import type { RpcRouteInfo } from "./core";
{% if routes %}
export const routes = {
{% for route in routes %}  {{ route | route_key }}: {
    method: {{ route.rpc_name | literal }},
{% if route.server is not none %}    server: {{ route.server | literal }},
{% endif %}  },
{% endfor %}} as const satisfies Record<string, RpcRouteInfo>;
{% endif %}{% if notifications %}
export const notifications = {
{% for event in notifications %}  {{ event | route_key }}: {
    method: {{ event.rpc_name | literal }},
{% if event.server is not none %}    server: {{ event.server | literal }},
{% endif %}  },
{% endfor %}} as const satisfies Record<string, RpcRouteInfo>;
{% endif %}
