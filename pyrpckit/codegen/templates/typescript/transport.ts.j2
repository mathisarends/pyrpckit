import { RpcRemoteError } from "./core";

export type RpcTransport = {
  request(method: string, params?: object): Promise<unknown>;
  notifications(): AsyncIterable<unknown>;
  close(): Promise<void>;
};

export type WebSocketFactory = (
  url: string,
  protocols?: readonly string[],
) => WebSocketSocket;

export type WebSocketOptions = {
  readonly subprotocols?: readonly string[];
  readonly requestTimeoutMs?: number;
  readonly notificationQueueSize?: number;
  readonly socketFactory?: WebSocketFactory;
};

type WebSocketSocket = {
  readonly readyState: number;
  send(data: string): void;
  close(): void;
  addEventListener(
    type: "open" | "close" | "error",
    listener: () => void,
  ): void;
  addEventListener(
    type: "message",
    listener: (event: { readonly data: unknown }) => void,
  ): void;
};

type PendingRequest = {
  readonly method: string;
  readonly resolve: (value: unknown) => void;
  readonly reject: (error: unknown) => void;
  readonly timeout?: ReturnType<typeof setTimeout>;
};

type JsonObject = Record<string, unknown>;

export class WebSocketTransport implements RpcTransport {
  readonly #socket: WebSocketSocket;
  readonly #requestTimeoutMs?: number;
  readonly #notifications: AsyncQueue<JsonObject>;
  readonly #pending = new Map<number, PendingRequest>();
  #nextRequestId = 1;
  #closed = false;

  private constructor(socket: WebSocketSocket, options: WebSocketOptions) {
    this.#socket = socket;
    this.#requestTimeoutMs = options.requestTimeoutMs;
    this.#notifications = new AsyncQueue(options.notificationQueueSize ?? 100);
    socket.addEventListener("message", (event) => this.#receive(event.data));
    socket.addEventListener("error", () => {
      this.#fail(new Error("The WebSocket connection failed"));
    });
    socket.addEventListener("close", () => {
      this.#fail(new Error("The WebSocket connection closed"));
    });
  }

  static async open(
    url: string,
    options: WebSocketOptions = {},
  ): Promise<WebSocketTransport> {
    const factory = options.socketFactory ?? defaultWebSocketFactory;
    const socket = factory(url, options.subprotocols);
    await waitForOpen(socket);
    return new WebSocketTransport(socket, options);
  }

  request(method: string, params?: object): Promise<unknown> {
    if (this.#closed)
      return Promise.reject(new Error("The WebSocket is closed"));
    const id = this.#nextRequestId++;
    const message: JsonObject = { jsonrpc: "2.0", id, method };
    if (params !== undefined) message.params = params;
    return new Promise((resolve, reject) => {
      const timeout =
        this.#requestTimeoutMs === undefined
          ? undefined
          : setTimeout(() => {
              this.#pending.delete(id);
              reject(new Error(`RPC request ${method} timed out`));
            }, this.#requestTimeoutMs);
      this.#pending.set(id, { method, resolve, reject, timeout });
      try {
        this.#socket.send(JSON.stringify(message));
      } catch (error) {
        this.#pending.delete(id);
        if (timeout !== undefined) clearTimeout(timeout);
        reject(error);
      }
    });
  }

  notifications(): AsyncIterable<JsonObject> {
    return this.#notifications;
  }

  async close(): Promise<void> {
    if (this.#closed) return;
    this.#closed = true;
    this.#socket.close();
    this.#fail(new Error("The WebSocket transport was closed"));
  }

  #receive(raw: unknown): void {
    try {
      const message = decodeMessage(raw);
      if ("id" in message) this.#resolveResponse(message);
      else if (typeof message.method === "string")
        this.#notifications.push(message);
      else throw new Error("Invalid JSON-RPC message");
    } catch (error) {
      this.#fail(error);
      this.#socket.close();
    }
  }

  #resolveResponse(message: JsonObject): void {
    const id = message.id;
    if (typeof id !== "number" || !Number.isInteger(id)) {
      throw new Error("JSON-RPC response IDs must be integers");
    }
    const pending = this.#pending.get(id);
    if (pending === undefined)
      throw new Error(`Unknown JSON-RPC response ID: ${id}`);
    this.#pending.delete(id);
    if (pending.timeout !== undefined) clearTimeout(pending.timeout);
    if (isObject(message.error)) {
      pending.reject(
        new RpcRemoteError(
          Number(message.error.code),
          String(message.error.message ?? "Remote RPC error"),
          message.error.data,
        ),
      );
    } else if ("result" in message) pending.resolve(message.result);
    else throw new Error("JSON-RPC response has no result or error");
  }

  #fail(error: unknown): void {
    if (!this.#closed) this.#closed = true;
    for (const pending of this.#pending.values()) {
      if (pending.timeout !== undefined) clearTimeout(pending.timeout);
      pending.reject(error);
    }
    this.#pending.clear();
    this.#notifications.fail(error);
  }
}

class AsyncQueue<Value> implements AsyncIterableIterator<Value> {
  readonly #capacity: number;
  readonly #values: Value[] = [];
  readonly #waiters: Array<{
    readonly resolve: (result: IteratorResult<Value>) => void;
    readonly reject: (error: unknown) => void;
  }> = [];
  #failure?: unknown;

  constructor(capacity: number) {
    if (!Number.isInteger(capacity) || capacity <= 0) {
      throw new Error("notificationQueueSize must be a positive integer");
    }
    this.#capacity = capacity;
  }

  [Symbol.asyncIterator](): AsyncIterableIterator<Value> {
    return this;
  }

  next(): Promise<IteratorResult<Value>> {
    const value = this.#values.shift();
    if (value !== undefined) return Promise.resolve({ value, done: false });
    if (this.#failure !== undefined) return Promise.reject(this.#failure);
    return new Promise((resolve, reject) =>
      this.#waiters.push({ resolve, reject }),
    );
  }

  push(value: Value): void {
    const waiter = this.#waiters.shift();
    if (waiter !== undefined) {
      waiter.resolve({ value, done: false });
      return;
    }
    if (this.#values.length === this.#capacity) {
      throw new Error("The WebSocket notification queue overflowed");
    }
    this.#values.push(value);
  }

  fail(error: unknown): void {
    if (this.#failure !== undefined) return;
    this.#failure = error;
    for (const waiter of this.#waiters.splice(0)) waiter.reject(error);
  }
}

function defaultWebSocketFactory(
  url: string,
  protocols?: readonly string[],
): WebSocketSocket {
  const constructor = (
    globalThis as unknown as {
      readonly WebSocket?: new (
        url: string,
        protocols?: readonly string[],
      ) => WebSocketSocket;
    }
  ).WebSocket;
  if (constructor === undefined) {
    throw new Error(
      "No global WebSocket implementation is available; provide socketFactory",
    );
  }
  return new constructor(url, protocols);
}

function waitForOpen(socket: WebSocketSocket): Promise<void> {
  if (socket.readyState === 1) return Promise.resolve();
  return new Promise((resolve, reject) => {
    socket.addEventListener("open", resolve);
    socket.addEventListener("error", () =>
      reject(new Error("WebSocket open failed")),
    );
    socket.addEventListener("close", () =>
      reject(new Error("WebSocket closed")),
    );
  });
}

function decodeMessage(raw: unknown): JsonObject {
  if (typeof raw !== "string")
    throw new Error("WebSocket messages must be text");
  const message: unknown = JSON.parse(raw);
  if (!isObject(message) || message.jsonrpc !== "2.0") {
    throw new Error("Invalid JSON-RPC message");
  }
  return message;
}

function isObject(value: unknown): value is JsonObject {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}
