export type RpcTransportDescriptor =
  | {
      readonly type: "websocket";
      readonly messageEncoding: "json";
      readonly subprotocols?: readonly string[];
    }
  | {
      readonly type: string;
      readonly [option: string]: unknown;
    };

type RpcServerVariable = {
  readonly default: string;
  readonly description?: string;
  readonly enum?: readonly string[];
};

type RpcServerInfo = {
  readonly name: string;
  readonly url: string;
  readonly summary?: string;
  readonly description?: string;
  readonly variables?: Readonly<Record<string, RpcServerVariable>>;
  readonly transport?: RpcTransportDescriptor;
};

export type ServerName = {% for server in servers %}{{ " | " if not loop.first else "" }}{{ server.name | literal }}{% endfor %};

export type Endpoint = {
  readonly server: ServerName;
  readonly url: string;
  readonly subprotocols: readonly string[];
};

export const servers = {
{% for server in servers %}  {{ server.name | identifier }}: {
    name: {{ server.name | literal }},
    url: {{ server.url | literal }},
{% if server.summary %}    summary: {{ server.summary | literal }},
{% endif %}{% if server.description %}    description: {{ server.description | literal }},
{% endif %}{% if server.transport is not none %}    transport: {
      type: {{ server.transport.type | literal }},
{% if server.transport.message_encoding is not none %}      messageEncoding: {{ server.transport.message_encoding | literal }},
{% endif %}{% if server.transport.subprotocols %}      subprotocols: {{ server.transport.subprotocols | array }},
{% endif %}{% for name, value in server.transport.options %}      {{ name | property }}: {{ value | literal }},
{% endfor %}    },
{% endif %}{% if server.variables %}    variables: {
{% for variable in server.variables %}      {{ variable.name | property }}: {
        default: {{ variable.default | literal }},
{% if variable.description %}        description: {{ variable.description | literal }},
{% endif %}{% if variable.enum %}        enum: {{ variable.enum | array }},
{% endif %}      },
{% endfor %}    },
{% endif %}  },
{% endfor %}} as const satisfies Record<string, RpcServerInfo>;

{% for server in servers %}function {{ server.name | identifier }}({% if server.variables %}
  variables: {
{% for variable in server.variables %}    {{ variable.name | property }}?: {{ variable | server_variable_type }};
{% endfor %}  } = {},
{% endif %}): Endpoint {
  return {
    server: {{ server.name | literal }},
    url: {% if server.variables %}resolveUrl(servers.{{ server.name | identifier }}, variables){% else %}servers.{{ server.name | identifier }}.url{% endif %},
    subprotocols: {{ server | subprotocols }},
  };
}

{% endfor %}export const endpoints = {
{% for server in servers %}  {{ server.name | identifier }},
{% endfor %}} as const;

export function resolveEndpoints(
  overrides: readonly Endpoint[],
): readonly Endpoint[] {
  const resolved = new Map<ServerName, Endpoint>([
{% for server in servers %}    [{{ server.name | literal }}, {{ server.name | identifier }}()],
{% endfor %}  ]);
  const supplied = new Set<ServerName>();
  for (const endpoint of overrides) {
    if (supplied.has(endpoint.server)) {
      throw new Error(`Duplicate endpoint for ${endpoint.server}`);
    }
    supplied.add(endpoint.server);
    resolved.set(endpoint.server, endpoint);
  }
  return [...resolved.values()];
}

function resolveUrl(
  server: RpcServerInfo,
  values: Readonly<Record<string, string>>,
): string {
  let url = server.url;
  for (const [name, variable] of Object.entries(server.variables ?? {})) {
    const value = values[name] ?? variable.default;
    if (variable.enum !== undefined && !variable.enum.includes(value)) {
      throw new Error(`Invalid value for server variable ${name}: ${value}`);
    }
    url = url.replaceAll(`{${name}}`, value);
  }
  return url;
}
