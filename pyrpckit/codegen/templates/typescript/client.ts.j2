{% from "typescript/macros.ts.j2" import operation, notification, stream with context %}{% for line in imports %}{{ line }}
{% endfor %}
export class {{ client_name }} {
{% for node in nodes %}  readonly {{ node.segment | identifier }}: {{ node.path | api_class }};
{% endfor %}{% if nodes %}
{% endif %}  readonly #rpc: RpcClientCore;

  constructor(
{% if servers %}    transport:
      | RpcTransport
      | Readonly<Record<ServerName, RpcTransport>>
      | RpcTransportSource,
{% else %}    transport: RpcTransport | RpcTransportSource,
{% endif %}    options?: {
      readonly closeTransport?: boolean;
      readonly hooks?: readonly RpcClientHook[];
{% if binary_streams %}      readonly streamOpener?: BinaryStreamOpener;
      readonly variables?: Readonly<Record<string, string>>;
{% endif %}    },
  ) {
    this.#rpc = new RpcClientCore(transport, options);
{% for node in nodes %}    this.{{ node.segment | identifier }} = new {{ node.path | api_class }}(this.#rpc);
{% endfor %}  }

  /** Build a client on transports the caller owns, for tests and adapters. */
  static withTransports(
{% if servers %}    transports: RpcTransport | Readonly<Record<ServerName, RpcTransport>>,
{% else %}    transports: RpcTransport,
{% endif %}    options?: {
      readonly closeTransport?: boolean;
      readonly hooks?: readonly RpcClientHook[];
{% if binary_streams %}      readonly streamOpener?: BinaryStreamOpener;
      readonly variables?: Readonly<Record<string, string>>;
{% endif %}    },
  ): {{ client_name }} {
    return new {{ client_name }}(transports, options);
  }
{% if with_websocket %}
  /** Connect to every declared server, opening each socket on first use. */
  static async connect(
    options: {
{% for variable in variables %}      readonly {{ variable.name | property }}?: {{ variable | server_variable_type }};
{% endfor %}{% if servers | length == 1 %}      readonly url?: string | URL;
{% endif %}      readonly servers?: EndpointOverrides;
      readonly lazy?: boolean;
      readonly requestTimeoutMs?: number | null;
      readonly notificationQueueSize?: number;
      readonly notificationOverflow?: "drop_oldest" | "close";
      readonly socketFactory?: WebSocketFactory;
      readonly onDisconnect?: (error: unknown) => void;
      readonly reconnect?: boolean;
      readonly reconnectInitialDelayMs?: number;
      readonly reconnectMaxDelayMs?: number;
{% if binary_streams %}      readonly streamSocketFactory?: BinaryWebSocketFactory;
      readonly streamQueueSize?: number;
{% endif %}      readonly hooks?: readonly RpcClientHook[];
    } = {},
  ): Promise<{{ client_name }}> {
{% if variables %}    const variables: Record<string, string | undefined> = {
{% for variable in variables %}      {{ variable.name | property }}: options.{{ variable.name | property }},
{% endfor %}    };
{% else %}    const variables: Record<string, string | undefined> = {};
{% endif %}
{% if servers | length == 1 %}    const overrides: EndpointOverrides = { ...options.servers };
    if (options.url !== undefined) {
      overrides[{{ servers[0].name | literal }}] ??= options.url;
    }
{% endif %}    const pool = new RpcTransportPool({
      endpoints: [...resolveEndpoints(variables, {{ "overrides" if servers | length == 1 else "options.servers" }})],
      reconnect: options.reconnect,
      reconnectInitialDelayMs: options.reconnectInitialDelayMs,
      reconnectMaxDelayMs: options.reconnectMaxDelayMs,
      open: (endpoint, disconnected) =>
        WebSocketTransport.open(endpoint.url, {
          subprotocols: endpoint.subprotocols,
          requestTimeoutMs: options.requestTimeoutMs,
          notificationQueueSize: options.notificationQueueSize,
          notificationOverflow: options.notificationOverflow,
          socketFactory: options.socketFactory,
          onDisconnect: (error) => {
            disconnected(error);
            options.onDisconnect?.(error);
          },
        }),
    });
    if (!options.lazy) await pool.openAll();
    return new {{ client_name }}(pool, {
      hooks: options.hooks,
{% if binary_streams %}      streamOpener: (endpoint) =>
        BinaryWebSocketStream.open(endpoint, {
          socketFactory: options.streamSocketFactory,
          incomingQueueSize: options.streamQueueSize,
        }),
      variables: definedVariables(variables),
{% endif %}    });
  }
{% endif %}{% for route in operations %}
{{ operation(route, true) }}{% endfor %}{% for event in notifications %}
{{ notification(event, true) }}{% endfor %}{% for item in streams %}
{{ stream(item, true) }}{% endfor %}
  close(): Promise<void> {
    return this.#rpc.close();
  }

  [Symbol.asyncDispose](): Promise<void> {
    return this.close();
  }
}
{% if with_websocket and binary_streams %}
function definedVariables(
  values: Readonly<Record<string, string | undefined>>,
): Readonly<Record<string, string>> {
  return Object.fromEntries(
    Object.entries(values).filter(([, value]) => value !== undefined),
  ) as Record<string, string>;
}
{% endif %}
