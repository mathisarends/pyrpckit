{% macro operation(route) %}    async def {{ route.operation_name | identifier }}({% if not route.params %}self{% else %}
        self,
        *,
{% for parameter in route.params %}        {{ parameter.name | identifier }}: {{ parameter | parameter_annotation }},
{% endfor %}    {% endif %}) -> {{ route.result | annotation }}:
{% set description = route.summary or route.description %}{% if description %}        """{{ description | docstring }}"""
{% endif %}{% if route.params_model is not none %}{% if route.params | direct_params %}        params = {{ route.params_model | schema_name }}(
{% for parameter in route.params %}            {{ parameter.name | identifier }}={{ parameter.name | identifier }},
{% endfor %}        )
{% else %}        values: dict[str, object] = {}
{% for parameter in route.params %}{% if parameter.required %}        values[{{ parameter.name | literal }}] = {{ parameter.name | identifier }}
{% else %}        if {{ parameter.name | identifier }} is not UNSET:
            values[{{ parameter.name | literal }}] = {{ parameter.name | identifier }}
{% endif %}{% endfor %}        params = {{ route.params_model | schema_name }}.model_validate(values)
{% endif %}{% endif %}        {{ "await" if route.result | null_type else "return await" }} self._rpc.request(
            {{ route.method_member }},
{% if route.params_model is not none %}            params=params.model_dump(mode="json", by_alias=True, exclude_unset=True),
{% endif %}        )
{% endmacro %}

{% macro notification(event) %}    def {{ event.operation_name | identifier }}(self) -> AsyncIterator[{{ event.payload | annotation }}]:
{% if event.summary %}        """{{ event.summary | docstring }}"""
{% endif %}        return self._rpc.subscribe({{ event.rpc_name | constant }})
{% endmacro %}

{% macro stream(item) %}    def {{ item.operation_name | identifier }}(
        self,
        *,
{% for variable in item.variables %}        {{ variable.name | identifier }}: {{ variable | variable_annotation }} | None = None,
{% endfor %}        url: str | None = None,
    ) -> BinaryStreamOpening[{{ item | stream_connection }}]:
{% if item.summary %}        """{{ item.summary | docstring }}"""
{% endif %}        return BinaryStreamOpening(
            resolve_stream_endpoint(
                BINARY_STREAMS[BinaryStreamName.{{ item.name | constant }}],
{% if item.variables %}                {
{% for variable in item.variables %}                    {{ variable.name | literal }}: {{ variable.name | identifier }},
{% endfor %}                },
{% endif %}                url=url,
                defaults=self._rpc.variables,
            ),
            self._rpc.stream_opener,
            {{ item | stream_connection }},
        )
{% endmacro %}
