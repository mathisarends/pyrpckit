{% for group in groups %}class {{ group.class_name }}(ABC):
    """Requests this client handles for the server; implement and register them."""
{% for route in group.client_methods %}
    @abstractmethod
{% if route.summary or route.description %}{{ route | client_method_signature }}
        """{{ (route.summary or route.description) | docstring }}"""
{% else %}{{ route | client_method_signature }} ...
{% endif %}{% endfor %}

{% endfor %}{{ handler_alias }}

_HANDLER_METHODS: tuple[RpcClientMethodInfo, ...] = (
{% for group in groups %}{% for route in group.client_methods %}    RpcClientMethodInfo(
        method={{ route.rpc_name | literal }},
        owner={{ group.class_name }},
        attribute={{ (route.operation_name | identifier) | literal }},
        params_adapter={% if route.params_model is not none %}TypeAdapter({{ route.params_model | schema_name }}){% else %}None{% endif %},
        result_adapter=TypeAdapter({{ route.result | annotation }}),
{% if route.server is not none %}        server={{ route.server | literal }},
{% endif %}    ),
{% endfor %}{% endfor %})


def handler_dispatcher(
    handlers: Handler | Iterable[Handler] = (),
) -> RpcClientMethodDispatcher:
    """Answer the server's requests with the given handlers."""
    return RpcClientMethodDispatcher(_HANDLER_METHODS, handlers)
